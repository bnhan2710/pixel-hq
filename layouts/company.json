{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "company-brand"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 0.4
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "company-agents"
              },
              "size": {
                "weight": 1.7
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "#171412",
      "border": {
        "width": 1,
        "color": "#ffffff14"
      },
      "radius": 14,
      "shadow": "md",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "background": "#171412",
          "border": {
            "width": 1,
            "color": "#ffffff14"
          },
          "radius": 12,
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "company-pane"
                    },
                    "reveal": "always",
                    "height": 40,
                    "position": "top"
                  },
                  "background": "#1f1c1a",
                  "border": {
                    "width": 1,
                    "color": "#ffffff14"
                  },
                  "focus": {
                    "width": 1.5,
                    "color": "#D97757"
                  },
                  "radius": 14,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "company-status"
          },
          "size": {
            "px": 28
          },
          "background": "#171412",
          "border": {
            "width": 1,
            "color": "#ffffff14"
          },
          "radius": 12
        }
      ],
      "gap": 8,
      "resizable": false
    }
  ],
  "background": "#100e0d",
  "padding": 8,
  "colors": {
    "accent": "#D97757",
    "chrome": "#171412",
    "canvas": "#100e0d",
    "background": "#1f1c1a",
    "surface": "#2a2420",
    "raised": "#332b26",
    "border": "#ffffff14",
    "hover": "#ffffff10",
    "selected": "#ffffff14"
  },
  "terminal_padding": [
    16,
    14
  ],
  "terminal_opacity": 1,
  "gap": 8,
  "divider": {
    "width": 0,
    "color": "#00000000"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}